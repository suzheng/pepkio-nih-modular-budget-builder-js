{
  "name": "pepkio-nih-modular-budget-builder",
  "version": "0.1.0",
  "description": "Convert personnel effort and salary into NIH modular budget modules with cap-limited salary, fringe, F&A, and PHS398 justification text via the Pepkio Tools REST API.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "pepkio-nih-modular-budget-builder": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --exclude '**/integration.test.ts'",
    "test:integration": "vitest run integration.test.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepkio/pepkio-nih-modular-budget-builder-js.git"
  },
  "bugs": {
    "url": "https://github.com/pepkio/pepkio-nih-modular-budget-builder-js/issues"
  },
  "homepage": "https://www.pepkio.com/tools/nih-modular-budget-builder",
  "keywords": [
    "nih-modular-budget-builder",
    "nih",
    "grants",
    "budget",
    "modular",
    "phs398",
    "administration",
    "lab-operations",
    "pepkio",
    "typescript",
    "node",
    "rest-api"
  ],
  "author": "Pepkio Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
